# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.10
ARG NODE_VERSION=24.11.1

FROM node:${NODE_VERSION}-bookworm AS webapp
WORKDIR /src/webapp
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY webapp/ ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund
RUN npm run build

FROM golang:${GO_VERSION}-bookworm AS server
ENV GOTOOLCHAIN=auto
WORKDIR /src/server
COPY server/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    rm -f go.work go.work.sum \
 && go work init . ./public \
 && go build -o /out/mattermost ./cmd/mattermost

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl mailcap tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 2000 --user-group --home-dir /mattermost mattermost

WORKDIR /mattermost
COPY --from=server /out/mattermost ./bin/mattermost
COPY --from=webapp /src/webapp/channels/dist ./client
COPY server/i18n      ./i18n
COPY server/templates ./templates
COPY server/fonts     ./fonts

RUN mkdir -p config data logs plugins client/plugins \
 && chown -R mattermost:mattermost /mattermost

ENV PATH="/mattermost/bin:${PATH}" \
    MM_SQLSETTINGS_DRIVERNAME=postgres \
    MM_SERVICESETTINGS_SITEURL=http://localhost:8065

USER mattermost
EXPOSE 8065
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD curl -fsS http://localhost:8065/api/v4/system/ping || exit 1
ENTRYPOINT ["/mattermost/bin/mattermost"]
